# Copy to viz/.env to override defaults.

# Timeline + attribution data (observer WS) and the attribution service.
VITE_WS_URL=ws://localhost:8765
VITE_ATTRIBUTION_URL=http://localhost:8001

# The agent's SmallWebRTC offer endpoint for the in-UI "Start call".
# Default routes through the Vite dev proxy (/agent -> localhost:7860) to avoid CORS.
# Override only if your agent runs elsewhere, e.g. https://my-agent.example/api/offer
# VITE_AGENT_URL=/agent/api/offer
