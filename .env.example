# Ember — environment template
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — core demo path
# ─────────────────────────────────────────────────────────────────────────────

# NVIDIA Nemotron (vLLM, OpenAI-compatible endpoint).
# Powers both the agent's LLM and the attribution service's echo-scoring.
# The whole attribution method depends on this exposing echo/prompt_logprobs —
# run the spike in CLAUDE.md "Critical path" before building anything else.
# URL is the OpenAI-compatible base (the service appends /completions, /chat/completions).
NEMOTRON_LLM_URL=https://your-nemotron-alb-endpoint/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super-120b
NEMOTRON_API_KEY=

# Gradium — STT + TTS for the Pipecat voice pipeline.
# Also powers the viz "Re-synthesize" feature (TTS-only replay in a chosen voice
# via the attribution service's /synthesize endpoint).
GRADIUM_API_KEY=
# Optional overrides for /synthesize (sane defaults baked in):
# GRADIUM_TTS_URL=wss://api.gradium.ai/api/speech/tts
# GRADIUM_SAMPLE_RATE=48000

# Cekura — eval scores mapped to turns.
# Usually provisioned via the Claude Code plugin (/cekura-report); set here only
# if the agent/service calls the Cekura API directly.
CEKURA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE WIRING — local defaults, override if you change ports/hosts
# ─────────────────────────────────────────────────────────────────────────────

# Attribution service (FastAPI). The viz and agent point at this.
ATTRIBUTION_PORT=8001
ATTRIBUTION_URL=http://localhost:8001

# Agent (Pipecat). Talk at http://localhost:7860 by default.
AGENT_PORT=7860

# Number of parallel echo-scoring calls (one per ablated prompt block).
ATTRIBUTION_K=8

# WebSocket the viz subscribes to for live session frames.
VIZ_WS_URL=ws://localhost:7860/ws

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — only if you go past local SmallWebRTC
# ─────────────────────────────────────────────────────────────────────────────

# Twilio — phone-based calling. Optional; SmallWebRTC works locally without it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Daily — hosted WebRTC transport (hackathon sponsor). Optional.
DAILY_API_KEY=
DAILY_SAMPLE_ROOM_URL=

# AWS — only if you provision/host the Nemotron endpoint yourself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
